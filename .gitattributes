# Normalize line endings
* text=auto eol=lf

# Force text for source files
*.ts   text eol=lf
*.tsx  text eol=lf
*.css  text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.mjs  text eol=lf
*.mts  text eol=lf

# Binary files — never convert
*.ico  binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.webp binary
*.svg  binary
